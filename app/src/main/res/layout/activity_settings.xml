<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_dark">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="@string/title_settings"
            app:titleTextColor="@color/text_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card 1: AI Configuration -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/section_ai_config"
                    android:textColor="@color/primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Nút chọn mẫu cấu hình sẵn nhanh (Presets) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPresetProvider"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="#152033"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="⚡ CHỌN MẪU (OPENAI / MISTRAL / GROQ / OLLAMA)"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    app:cornerRadius="6dp"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp" />

                <!-- Base URL -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:hint="@string/label_base_url"
                    android:textColorHint="@color/text_secondary"
                    app:boxBackgroundColor="#1A2438"
                    app:boxStrokeColor="@color/primary"
                    app:hintTextColor="@color/primary"
                    app:helperText="OpenAI: https://api.openai.com/v1 | Mistral: https://api.mistral.ai/v1"
                    app:helperTextTextColor="@color/text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBaseUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:text="https://api.openai.com/v1"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- API Key -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:hint="@string/label_api_key"
                    android:textColorHint="@color/text_secondary"
                    app:boxBackgroundColor="#1A2438"
                    app:boxStrokeColor="@color/primary"
                    app:hintTextColor="@color/primary"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="@color/text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etApiKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_api_key"
                        android:inputType="textPassword"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Model Name -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="@string/label_model"
                    android:textColorHint="@color/text_secondary"
                    app:boxBackgroundColor="#1A2438"
                    app:boxStrokeColor="@color/primary"
                    app:hintTextColor="@color/primary"
                    app:helperText="OpenAI: gpt-4o-mini | Mistral: pixtral-12b-2409"
                    app:helperTextTextColor="@color/text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etModelName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="gpt-4o-mini"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Nút Lưu cấu hình AI -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveAiConfig"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/primary"
                    android:text="@string/btn_save"
                    android:textColor="@color/bg_dark"
                    android:textStyle="bold"
                    app:cornerRadius="8dp" />

                <!-- Nút Kiểm tra kết nối AI -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTestAiConnection"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#1A2438"
                    android:text="⚡ KIỂM TRA KẾT NỐI AI"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp" />

                <TextView
                    android:id="@+id/tvConnectionResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text=""
                    android:textColor="@color/status_green"
                    android:textSize="12sp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Card: Vision & Behavior Agent -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thị giác &amp; Tác vụ đa bước (Agent)"
                    android:textColor="@color/primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp"
                    android:text="Quan sát màn hình, đọc chữ On-Device OCR và tự động thực thi các chuỗi hành vi thông minh (ReAct Agent)"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <!-- Bật chế độ quan sát thị giác -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchVisionMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bật chế độ quan sát thị giác (Vision)"
                    android:textColor="@color/text_primary"
                    app:thumbTint="@color/primary"
                    app:trackTint="#4000E5FF" />

                <!-- Bật Behavior Agent -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchBehaviorAgent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Bật tự động hóa đa bước (Behavior Agent)"
                    android:textColor="@color/text_primary"
                    app:thumbTint="@color/primary"
                    app:trackTint="#4000E5FF" />

                <!-- Giới hạn số bước hành động tối đa -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Số bước tối đa mỗi tác vụ"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvAgentMaxStepsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="8 bước"
                        android:textColor="@color/primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekAgentMaxSteps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="12"
                    android:progress="5"
                    android:progressTint="@color/primary"
                    android:thumbTint="@color/primary" />

                <!-- Nút Quản lý Guardrails (Blacklist/Whitelist) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManageGuardrails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#1A2438"
                    android:text="🛡️ QUY TẮC BẢO VỆ (GUARDRAILS)"
                    android:textColor="@color/primary"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp" />

                <!-- Nút Xem Lịch sử tác vụ -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewTaskHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#1A2438"
                    android:text="📜 LỊCH SỬ TÁC VỤ (TASK HISTORY)"
                    android:textColor="@color/text_primary"
                    app:cornerRadius="8dp"
                    app:strokeColor="#2A3B5C"
                    app:strokeWidth="1dp" />

                <!-- Nút Xóa toàn bộ lịch sử -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearAllHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#2A1515"
                    android:text="🗑️ XÓA TOÀN BỘ LỊCH SỬ TÁC VỤ"
                    android:textColor="#FF5252"
                    app:cornerRadius="8dp"
                    app:strokeColor="#FF5252"
                    app:strokeWidth="1dp" />

            </LinearLayout>

            <!-- Card 2: Wake Word Configuration -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_wakeword"
                    android:textColor="@color/primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/desc_wakeword"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchWakeWord"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/enable_wakeword"
                    android:textColor="@color/text_primary"
                    app:thumbTint="@color/primary"
                    app:trackTint="#4000E5FF" />

                <!-- Độ nhạy Wake Word (Threshold) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Độ nhạy nhận diện (Threshold)"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvThresholdValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="0.30"
                            android:textColor="@color/primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekWakeWordThreshold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="4dp"
                        android:max="60"
                        android:progress="20"
                        android:progressTint="@color/primary"
                        android:thumbTint="@color/primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Khuyến nghị: 0.30 (Phạm vi 0.10 - 0.70). Giá trị càng nhỏ càng nhạy, bắt tiếng nhạy hơn."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Công tắc bật/tắt viền sáng màn hình -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchGlowOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Viền sáng màn hình khi gọi AI"
                    android:textColor="@color/text_primary"
                    app:thumbTint="@color/primary"
                    app:trackTint="#4000E5FF" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp"
                    android:text="Hiệu ứng viền gradient phát sáng đa sắc quanh 4 cạnh màn hình (kiểu Siri / Google Assistant) khi đang nghe lệnh"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <!-- Nút hướng dẫn tối ưu chạy nền ColorOS / OPPO -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBatteryOptimization"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#1A2438"
                    android:text="⚡ Tối ưu chạy nền (ColorOS / OPPO)"
                    android:textColor="@color/primary"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPicovoiceKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/label_picovoice_key"
                    android:textColorHint="@color/text_secondary"
                    android:visibility="gone"
                    app:boxBackgroundColor="#1A2438"
                    app:boxStrokeColor="@color/primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPicovoiceKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- Card 3: Floating Overlay Mic Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_floating"
                    android:textColor="@color/primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/desc_floating_button"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchFloating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/enable_floating_button"
                    android:textColor="@color/text_primary"
                    app:thumbTint="@color/primary"
                    app:trackTint="#4000E5FF" />

            </LinearLayout>

            <!-- Card 4: Custom Commands -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/section_custom_commands"
                        android:textColor="@color/primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddCommand"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:backgroundTint="@color/primary"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/btn_add_command"
                        android:textColor="@color/bg_dark"
                        android:textSize="12sp"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_add"
                        app:iconSize="16dp"
                        app:iconTint="@color/bg_dark" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvEmptyCommands"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="16dp"
                    android:gravity="center"
                    android:text="@string/empty_custom_commands"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCustomCommands"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_custom_command" />

            </LinearLayout>

            <!-- Card 5: App Update (GitHub Releases) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cập nhật ứng dụng"
                    android:textColor="@color/primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp"
                    android:text="Tự động kiểm tra và cài đặt phiên bản APK mới nhất từ GitHub Releases mà không cần xóa app"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvCurrentVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Phiên bản hiện tại: Đang tải..."
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCheckUpdate"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/primary"
                    android:text="🔄 KIỂM TRA CẬP NHẬT"
                    android:textColor="@color/bg_dark"
                    android:textStyle="bold"
                    app:cornerRadius="10dp" />

                <!-- Container hiển thị tiến trình tải file APK -->
                <LinearLayout
                    android:id="@+id/layoutUpdateProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvUpdateProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="Đang tải: 0%"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressBarUpdate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        app:indicatorColor="@color/primary"
                        app:trackColor="#2A2A2A"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="8dp" />
                </LinearLayout>

                <!-- Nút Cài đặt APK khi tải xong -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInstallUpdate"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/status_green"
                    android:text="📲 CÀI ĐẶT BẢN CẬP NHẬT"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:cornerRadius="10dp" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
