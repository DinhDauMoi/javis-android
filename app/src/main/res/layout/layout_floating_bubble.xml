<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floatingRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Glowing Outer Ring -->
    <View
        android:id="@+id/floatingRing"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_pulse_ring"
        android:visibility="gone" />

    <!-- Circular Mic Bubble Button -->
    <ImageView
        android:id="@+id/floatingMicBtn"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_mic_button"
        android:contentDescription="Nút Mic nổi JAVIS"
        android:padding="12dp"
        android:src="@drawable/ic_mic" />

</FrameLayout>
